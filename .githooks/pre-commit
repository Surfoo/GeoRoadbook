#!/usr/bin/env bash

RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
ENDCOLOR="\e[0m"

status=0

# Run the tools inside the php-fpm container when it is up, locally otherwise.
if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^georoadbook-php-fpm$'; then
  run_php() { docker exec georoadbook-php-fpm "$@"; }
else
  run_php() { "$@"; }
fi

run_check() {
  local label="$1"
  shift
  echo -e "${YELLOW}▶ ${label}${ENDCOLOR}"
  if run_php "$@"; then
    echo -e "${GREEN}✔ ${label} OK${ENDCOLOR}"
  else
    echo -e "${RED}✘ ${label} failed${ENDCOLOR}"
    status=1
  fi
}

# Order: tools that modify the code (in dry-run) before static analysis.
# 1. Rector: deepest refactoring
run_check "Rector"       ./vendor/bin/rector --dry-run --ansi
# 2. php-cs-fixer: normalizes style after Rector
run_check "php-cs-fixer" ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --ansi
# 3. PHPStan: static analysis on the final result
run_check "PHPStan"      ./vendor/bin/phpstan --memory-limit=1G --ansi analyse
# 4. PHPUnit: fast test suite, catches regressions before they hit CI
run_check "PHPUnit"      ./vendor/bin/phpunit --colors=always

if [ "$status" -ne 0 ]; then
  echo -e "${RED}⚠ Errors detected during commit analysis ⚠${ENDCOLOR}"
  exit 1
fi

echo -e "${GREEN}All checks passed.${ENDCOLOR}"
exit 0
