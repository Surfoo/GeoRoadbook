{% extends 'main.html.twig' %}

{% block main %}
<div class="container text-center py-5">
    <div class="mx-auto" style="max-width: 480px;">
        <i class="bi bi-map fs-1 text-orange mb-3 d-block"></i>
        <h1 class="section-title mb-3">Roadbook not found</h1>
        <p class="page-desc mb-4">
            This roadbook doesn't exist, or it has been automatically deleted —
            roadbooks are kept for 30 days only.
        </p>
        <a href="{{ path('app_homepage') }}" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-house-door me-2"></i>Create a new roadbook
        </a>
    </div>
</div>
{% endblock %}
