{% extends 'main.html.twig' %}

{% block main %}

{# Hero Section #}
<div class="hero-section text-center">
    <div class="container">
        <span class="section-label">The ultimate geocaching roadbook tool</span>
        <h1 class="section-title">Ready for your next adventure?</h1>
        <p class="page-desc">Create your roadbook. Generate a customizable, ready-to-print trail booklet from your GPX files.</p>
    </div>
</div>

<div class="container pb-5">

    {# Flash messages #}
    {% for message in app.flashes('deleted') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <form action="#" method="post" data-roadbook-form>
        <div id="error" class="alert alert-warning d-none" role="alert"></div>

        {# Source Card #}
        <div class="card-glass mb-5">

            <div class="drop-zone mb-4" id="drop_zone" data-controller="symfony--ux-dropzone--dropzone">
                <input id="gpx" type="file" accept=".gpx" class="dropzone-input"
                       data-symfony--ux-dropzone--dropzone-target="input">
                <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
                    <i class="bi bi-geo-alt-fill fs-1 text-orange mb-2 d-block"></i>
                    <p class="mb-1 fw-bold text-primary">Drop your GPX file here</p>
                    <p class="small mb-0 dz-meta">or click to browse • 8MB max</p>
                </div>
                <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" style="display: none">
                    <span class="dropzone-preview-image" style="display: none" data-symfony--ux-dropzone--dropzone-target="previewImage"></span>
                    <div class="dropzone-preview-data">
                        <i class="bi bi-check-circle-fill fs-2 text-accent mb-2 d-block"></i>
                        <p class="mb-1 fw-bold dropzone-preview-filename dz-filename" data-symfony--ux-dropzone--dropzone-target="previewFilename"></p>
                        <p class="small mb-1 dz-meta dz-size"></p>
                        <button type="button" class="dropzone-preview-button dz-replace small" data-symfony--ux-dropzone--dropzone-target="previewClearButton">Replace</button>
                    </div>
                </div>
            </div>

            {% if pocketqueryList is defined %}
                <div class="mb-4">
                    <label class="form-label form-label-mono" for="pocket_list">Or choose a pocket query</label>
                    <select name="referenceCode" class="form-select" id="pocket_list">
                        <option value="">Select a query...</option>
                        {% for pq in pocketqueryList %}
                            <option value="{{ pq.referenceCode }}">{{ pq.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div>
                <label class="form-label form-label-mono" for="locale">Roadbook language</label>
                <select name="locale" class="form-select" id="locale" required>
                    <option value="">Choose a language…</option>
                    {% for code, name in locales %}
                        <option value="{{ code|e }}"{% if language is defined and language == code %} selected{% endif %}>{{ name|e }}</option>
                    {% endfor %}
                </select>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <i class="bi bi-info-circle text-sky"></i>
                    <span class="text-muted small">Controls headings and labels in the generated document, not your cache descriptions.</span>
                </div>
            </div>

            {% if themes is defined %}
                <div class="mt-4">
                    <label class="form-label form-label-mono" for="theme">Roadbook style</label>
                    <select name="theme" class="form-select" id="theme">
                        {% for key, theme in themes %}
                            <option value="{{ key|e }}">{{ theme.label|e }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
        </div>

        {# Options Grid #}
        <div class="options-grid">

            {# General Settings #}
            <div class="option-group-card">
                <div class="option-group-title mb-4">
                    <i class="bi bi-list-ul"></i> General Settings
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="sort" id="sort" value="1">
                        <label class="form-check-label fw-medium" for="sort">Sort caches</label>
                    </div>
                    <div id="sort_options" class="hidden ms-4 mt-2">
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort_by" id="sort1" value="name">
                                <label class="form-check-label small" for="sort1">By name</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort_by" id="sort2" value="owner">
                                <label class="form-check-label small" for="sort2">By owner</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort_by" id="sort3" value="difficulty">
                                <label class="form-check-label small" for="sort3">By difficulty</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="toc" id="toc" value="1">
                    <label class="form-check-label fw-medium" for="toc">Table of contents</label>
                </div>
            </div>

            {# Geocache Content #}
            <div class="option-group-card">
                <div class="option-group-title mb-4">
                    <i class="bi bi-box-seam"></i> Geocache Content
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="note" id="note" value="1">
                    <label class="form-check-label fw-medium" for="note">Note area</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="long_desc" id="long_desc" value="1">
                    <label class="form-check-label fw-medium" for="long_desc">Description</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="hint" id="hint" value="1">
                    <label class="form-check-label fw-medium" for="hint">Hints</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="waypoints" id="waypoints" value="1">
                    <label class="form-check-label fw-medium" for="waypoints">Waypoints</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="logs" id="logs" value="1">
                    <label class="form-check-label fw-medium" for="logs">Recent logs</label>
                </div>
            </div>
        </div>

        {# Cover Page #}
        <div class="option-group-card mt-4" style="max-width: 960px; margin-left: auto; margin-right: auto;">
            <div class="option-group-title mb-3">
                <i class="bi bi-image"></i> Cover page <span class="text-muted small fw-normal">(optional, e.g. for an upcoming event)</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label form-label-mono" for="cover_title">Title</label>
                    <input type="text" class="form-control" name="cover_title" id="cover_title" maxlength="120" placeholder="e.g. Summer Geocaching Meetup 2026">
                </div>
                <div class="col-md-6">
                    <label class="form-label form-label-mono" for="cover_image">Image</label>
                    <input type="file" class="form-control" name="cover_image" id="cover_image" accept="image/jpeg,image/png,image/webp">
                    <div class="small text-muted mt-1">JPEG, PNG or WebP, 5 MB max.</div>
                </div>
                <div class="col-12">
                    <label class="form-label form-label-mono" for="cover_description">Description</label>
                    <textarea class="form-control" name="cover_description" id="cover_description" rows="3" maxlength="500" placeholder="Date, meeting point, anything you'd like your guests to know…"></textarea>
                </div>
            </div>
        </div>

        {# Advanced Options #}
        <div class="option-group-card mt-4" style="max-width: 960px; margin-left: auto; margin-right: auto;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="option-group-title">
                    <i class="bi bi-gear-fill"></i> Advanced Options
                </div>
                <a href="#" class="advanced-toggle-link" id="toggle_advanced">Show advanced options</a>
            </div>

            <div class="advanced-options mt-4" id="advanced_section">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="images" id="images" value="1">
                            <label class="form-check-label" for="images">Remove images (save ink)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="spoilers" id="spoilers" value="1">
                            <label class="form-check-label" for="spoilers">Include spoilers (Spoilers4gpx)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="pagebreak" id="pagebreak" value="1">
                            <label class="form-check-label" for="pagebreak">Page break per cache</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Generate CTA #}
        <div class="d-flex justify-content-center mt-5">
            <button type="submit" id="create" name="send" class="btn btn-primary btn-lg btn-primary-action">
                Generate your roadbook
            </button>
        </div>

    </form>
</div>
{% endblock %}

