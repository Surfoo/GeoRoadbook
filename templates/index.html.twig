{% extends 'main.html.twig' %}

{% block main %}
<div class="pt-4 pb-5">

    {# Page header #}
    <div class="page-header mb-4">
        <span class="section-label">Geocaching Tool</span>
        <h1 class="section-title">Create your roadbook</h1>
        <p class="page-desc">Generate a customizable, ready-to-print roadbook from a GPX file (Pocket Queries, GSAK, GCTour…). Edit in-browser, then export as HTML, PDF, or ZIP. Your roadbook is private — only you know the link.</p>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('deleted') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <form action="#" method="post" enctype="multipart/form-data" class="form-body">

        <div id="error" class="alert alert-warning d-none" role="alert"></div>

        {# Source fieldset #}
        <fieldset class="mb-3">
            <legend>Source</legend>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label" for="gpx">
                        GPX file{% if pocketqueryList is defined %} or Pocket Query{% endif %}
                    </label>
                    <input id="gpx" type="file" class="file form-control" aria-describedby="helpBlockGpx">
                    <div id="helpBlockGpx" class="form-text">v1.0.1 only — 8 MB max.</div>

                    {% if pocketqueryList is defined %}
                        <label class="form-label mt-3" for="pocket_list">Your Pocket Queries</label>
                        <select name="referenceCode" class="form-select" id="pocket_list">
                            <option value=""></option>
                            {% for pq in pocketqueryList %}
                                <option value="{{ pq.referenceCode }}">{{ pq.name }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="locale">Roadbook language</label>
                    <select name="locale" class="form-select" id="locale" aria-describedby="helpBlockLanguage">
                        <option value=""></option>
                        {% for code, name in locales %}
                            <option value="{{ code|e }}"{% if language is defined and language == code %} selected{% endif %}>{{ name|e }}</option>
                        {% endfor %}
                    </select>
                    <div id="helpBlockLanguage" class="form-text">Language used in the roadbook output.</div>
                </div>
            </div>
        </fieldset>

        {# Options fieldset #}
        <fieldset class="mb-4" id="options">
            <legend>Options</legend>
            <div class="row mt-2">

                {# General column #}
                <div class="col-md-6">
                    <p class="option-group-label">General</p>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="sort" id="sort" value="1">
                            <label class="form-check-label" for="sort">Sort caches by</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Choose how to sort caches. Sorted according to your GPX file by default."></i>
                    </div>
                    <div id="sort_options" class="hidden sub-options">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="sort_by" id="sort1" value="name">
                            <label class="form-check-label" for="sort1">Name</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="sort_by" id="sort2" value="owner">
                            <label class="form-check-label" for="sort2">Owner</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="sort_by" id="sort3" value="difficulty">
                            <label class="form-check-label" for="sort3">Difficulty</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="sort_by" id="sort4" value="terrain">
                            <label class="form-check-label" for="sort4">Terrain</label>
                        </div>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="toc" id="toc" value="1">
                            <label class="form-check-label" for="toc">Table of contents</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display the summary of caches in 6 columns: Number, Type, Name, Found, Didn't Find and Page."></i>
                    </div>
                </div>

                {# Geocaches column #}
                <div class="col-md-6">
                    <p class="option-group-label">Geocaches</p>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="note" id="note" value="1">
                            <label class="form-check-label" for="note">Cache note area</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display a writing area for notes and calculations."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="images" id="images" value="1">
                            <label class="form-check-label" for="images">Remove images</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Remove images from the short and long description."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="short_desc" id="short_desc" value="1">
                            <label class="form-check-label" for="short_desc">Short description</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display the short description from caches."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="long_desc" id="long_desc" value="1">
                            <label class="form-check-label" for="long_desc">Long description</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display the long description from caches."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="hint" id="hint" value="1">
                            <label class="form-check-label" for="hint">Additional hints</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display the cache hints. Decrypted by default."></i>
                    </div>
                    <div id="hint_options" class="hidden sub-options">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="hint_encrypted" id="hint_decrypted" value="0" checked>
                            <label class="form-check-label" for="hint_decrypted">Decrypted</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="hint_encrypted" id="hint_encrypted" value="1">
                            <label class="form-check-label" for="hint_encrypted">Encrypted</label>
                        </div>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="spoilers" id="spoilers" value="1">
                            <label class="form-check-label" for="spoilers">
                                Spoilers <small><a href="http://spoilers4gpx.vaguelibre.net/#help" id="spoilers4gpx" target="_blank" rel="noopener">by Spoilers4gpx</a></small>
                            </label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display spoilers included by Spoilers4gpx."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="waypoints" id="waypoints" value="1">
                            <label class="form-check-label" for="waypoints">Waypoints</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display additional waypoints like parking, stage, questions, etc."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="logs" id="logs" value="1">
                            <label class="form-check-label" for="logs">Logs</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Display all logs from your GPX file."></i>
                    </div>

                    <div class="option-item">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" name="pagebreak" id="pagebreak" value="1">
                            <label class="form-check-label" for="pagebreak">Page break</label>
                        </div>
                        <i class="bi bi-question-circle option-help" data-bs-toggle="tooltip" title="Insert a page break between each cache."></i>
                    </div>
                </div>

            </div>
        </fieldset>

        {# Submit #}
        <div class="d-flex justify-content-end">
            <input type="submit" id="create" name="send" value="Create your roadbook" class="btn btn-primary btn-lg">
        </div>

    </form>
</div>
{% endblock %}

{% block body_scripts %}
<script src="/assets/jquery/jquery.min.js?{{ suffix_css_js }}"></script>
<script src="/assets/bootstrap-fileinput/js/fileinput.min.js?{{ suffix_css_js }}"></script>
<script src="/app.min.js?{{ suffix_css_js }}"></script>
{% endblock %}
