<!doctype html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8">
    <title>GeoRoadbook — create your geocaching roadbook</title>
    <meta name="description" content="GeoRoadbook is a free and open source web app to create your geocaching roadbook ready-to-print from your gpx file (Pocket queries, GSAK, GCTour, etc.)">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/design/icon-roadbook.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800&family=DM+Sans:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar border-bottom shadow-sm">
            <div class="container">
                <span class="navbar-brand-name">
                    <i class="bi bi-compass text-orange me-1"></i> GeoRoadbook
                </span>
                <div>
                    {% if app.user is empty %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm px-4 shadow-sm">Sign in</a>
                    {% else %}
                        <div class="hello-user d-flex align-items-center gap-2 px-3 py-1 rounded-pill">
                            <img src="{{ app.user.avatarUrl }}" loading="lazy" width="24" height="24" class="rounded-circle shadow-sm" alt="{{ app.user.username }}'s avatar">
                            <span class="small">{{ app.user.username }}</span>
                            <a href="{{ path('app_logout') }}" class="text-orange small ms-1 text-decoration-none fw-bold" title="Sign out"><i class="bi bi-box-arrow-right"></i></a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-shrink-0">
        <div class="container">
            {% if exception is defined %}
                <div class="alert alert-danger mt-4 border-0 shadow-sm d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
                    <div>
                        <strong class="d-block">{{ exception.type }}</strong>
                        <span class="small">{{ exception.message }}</span>
                    </div>
                </div>
            {% endif %}
            {% block main %}{% endblock %}
        </div>
    </main>

    <footer class="footer mt-auto py-5" style="background: white; border-top: 1px solid var(--border);">
        <div class="container text-center">
            <div class="mb-4">
                <span class="navbar-brand-name small text-muted opacity-50">◎ GEOROADBOOK</span>
            </div>
            <ul class="list-inline mb-4">
                <li class="list-inline-item px-3"><a href="#faq" class="text-secondary text-decoration-none small fw-medium" data-bs-toggle="modal" data-bs-target="#faq"><i class="bi bi-question-circle me-1"></i> FAQ</a></li>
                <li class="list-inline-item px-3 border-start"><a href="#about" class="text-secondary text-decoration-none small fw-medium" data-bs-toggle="modal" data-bs-target="#about"><i class="bi bi-info-circle me-1"></i> About</a></li>
                <li class="list-inline-item px-3 border-start"><a href="https://github.com/Surfoo/georoadbook" target="_blank" class="text-secondary text-decoration-none small fw-medium"><i class="bi bi-github me-1"></i> GitHub</a></li>
            </ul>
            <p class="mb-0 text-muted extra-small">Made with ❤️ for the world's geocachers. Happy hunting!</p>
        </div>
    </footer>

    {# Keep FAQ/About Modals... #}
    <div id="faq" class="modal fade" tabindex="-1">...</div>
    <div id="about" class="modal fade" tabindex="-1">...</div>

    {% block body_scripts %}{% endblock %}

</body>
</html>
