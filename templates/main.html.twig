<!doctype html>
<html lang="en" class="h-100" data-theme="light">
<head>
    <meta charset="utf-8">
    <title>GeoRoadbook — create your geocaching roadbook</title>
    <meta name="description" content="GeoRoadbook is a free and open source web app to create your geocaching roadbook ready-to-print from your gpx file (Pocket queries, GSAK, GCTour, etc.)">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/design/icon-roadbook.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script>
        (function () {
            var theme = localStorage.getItem('theme');
            if (!theme) {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar">
            <div class="container">
                <span class="navbar-brand-name">
                    <span class="text-orange">◎</span> GeoRoadbook
                </span>
                <div class="d-flex align-items-center gap-3">
                    <div class="theme-toggle" role="group" aria-label="Color theme">
                        <button type="button" data-set-theme="light" title="Light theme" aria-label="Light theme"><i class="bi bi-sun-fill"></i></button>
                        <button type="button" data-set-theme="dark" title="Dark theme" aria-label="Dark theme"><i class="bi bi-moon-fill"></i></button>
                    </div>
                    {% if app.user is empty %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm px-4">Sign in</a>
                    {% else %}
                        <div class="hello-user d-flex align-items-center gap-2 px-3 py-1 rounded-pill">
                            <img src="{{ app.user.avatarUrl }}" loading="lazy" width="24" height="24" class="rounded-circle" alt="{{ app.user.username }}'s avatar">
                            <span class="small">{{ app.user.username }}</span>
                        </div>
                        <a href="{{ path('app_logout') }}" class="text-muted small text-decoration-none border-start ps-3" style="border-color: var(--divider) !important;" title="Sign out">Sign out</a>
                    {% endif %}
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-shrink-0">
        {% if exception is defined %}
            <div class="container">
                <div class="alert alert-danger mt-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
                    <div>
                        <strong class="d-block">{{ exception.type }}</strong>
                        <span class="small">{{ exception.message }}</span>
                    </div>
                </div>
            </div>
        {% endif %}
        {% block main %}{% endblock %}
    </main>

    <footer class="footer mt-auto py-5">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <i class="bi bi-shield-check text-shield"></i>
                <span class="small text-secondary">Private &amp; Secure — roadbooks deleted after 30 days.</span>
            </div>
            <ul class="list-inline mb-3">
                <li class="list-inline-item px-3"><a href="#faq" class="text-decoration-none small fw-medium" data-bs-toggle="modal" data-bs-target="#faq">FAQ</a></li>
                <li class="list-inline-item px-3"><a href="#about" class="text-decoration-none small fw-medium" data-bs-toggle="modal" data-bs-target="#about">About</a></li>
                <li class="list-inline-item px-3"><a href="https://github.com/Surfoo/georoadbook" target="_blank" class="text-decoration-none small fw-medium">GitHub</a></li>
            </ul>
            <p class="mb-0 text-muted extra-small">Made with ❤️ for the world's geocachers. Happy hunting!</p>
        </div>
    </footer>

    {% include '_faq.twig.html' %}
    {% include '_about.twig.html' %}

    {% block body_scripts %}{% endblock %}

</body>
</html>
