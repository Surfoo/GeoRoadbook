<div class="cache" data-cache-id="{{ cache.code }}" id="{{ cache.code }}">
<div class="containers">
<div class="container1">
<h1 class="cacheTitle"><img src="{{ icons.cacheType(cache.type) }}" alt="{{ cache.type }}"/>{{ cache.name }}</h1>
<p><strong>{{ cache.displayCoordinates|replace({' E ': ' E ', ' W ': ' W '}) }}</strong></p>
<p>{{ t.difficulty }}<span>{% if icons.stars(cache.difficulty) %}<img src="{{ icons.stars(cache.difficulty) }}" alt="{{ cache.difficulty }}"/>{% endif %}</span>&#160;{{ t.terrain }}<span>{% if icons.stars(cache.terrain) %}<img src="{{ icons.stars(cache.terrain) }}" alt="{{ cache.terrain }}"/>{% endif %}</span></p>
</div>
<div class="container2">
<p class="cacheGCode">{{ cache.code }}</p>
<p>{% if cache.placedBy %}{{ t.by }}&#160;<strong>{{ cache.placedBy }}</strong>, {% endif %}{{ t.hidden }}<strong>&#160;{{ hiddenDate }}</strong></p>
<p>{% if icons.container(cache.container) %}{{ t.size }}&#160;<img src="{{ icons.container(cache.container) }}" alt="{{ cache.container }}"/>&#160;({{ t[cache.container|replace({' ': '_'})]|default(cache.container) }}){% endif %}</p>
<div class="clear"></div>
</div>
</div>
{% if cache.attributes is not empty %}
<ul class="cacheAttributes">
{% for attribute in cache.attributes %}{% if icons.attribute(attribute.id, attribute.inc) %}<li><img src="{{ icons.attribute(attribute.id, attribute.inc) }}" alt=""/></li>{% endif %}{% endfor %}
</ul>
{% endif %}
{% if options.display_note %}
<div class="cacheNote">
<p>{{ t.note }}</p>
</div>
{% endif %}
{% if options.display_long_desc and description %}
<div class="long_description">{{ description|raw }}</div>
{% endif %}
{% if options.display_hint and cache.hint %}
<div class="cacheHint">
<p>{{ t.hint }}</p>
<p class="cacheHintContent">{{ cache.hint|nl2br }}</p>
</div>
{% endif %}
{% if options.display_waypoints %}
<div class="cacheWaypoints">
{%- if cache.waypoints is not empty %}
<p>{{ t.waypoints|default('Waypoints') }}</p>
{% for waypoint in cache.waypoints %}
<p><strong>{{ waypoint.title }}{% if waypoint.coordinates %} - {{ waypoint.coordinates }}{% endif %}</strong><br/>{{ waypoint.comment }}</p>
{% endfor %}
{%- endif %}
</div>
{% endif %}
{% if options.display_spoilers %}
<div class="cacheSpoilers">
{%- if cache.spoilers is not empty %}
<p>{{ t.spoilers|default('Spoilers') }}</p>
{% for spoiler in cache.spoilers %}
<img src="{{ spoiler.url }}" alt="{{ spoiler.title }}"/><br/>
{% endfor %}
{%- endif %}
</div>
{% endif %}
{% if options.display_logs and cache.logs is not empty %}
<div class="cacheLogs">
<p>{{ t.logs }}</p>
<table>
{% for log in cache.logs %}
<tr>
<td class="finder_name">{% if icons.logType(log.type) %}<img src="{{ icons.logType(log.type) }}" alt="{{ log.type }}"/>{% else %}{{ log.type }} {% endif %}{{ log.finder }}</td>
<td class="cacheLogDate">{{ log.date ? log.date.format('d/m/Y') : '' }}</td>
</tr>
<tr>
<td class="cacheLogText" colspan="2">{{ log.text|nl2br }}<br/></td>
</tr>
{% endfor %}
</table>
</div>
{% endif %}
</div>
