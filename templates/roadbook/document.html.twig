<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
</head>
<body>
{% for item in items %}
    {%- if not loop.first %}
        {%- if options.pagebreak %}<p class="pagebreak"></p>{% else %}<hr class="separator"/>{% endif %}
    {%- endif %}
    {{- include('roadbook/_cache.html.twig', item, with_context = true) }}
{% endfor %}
</body>
</html>
